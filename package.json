{
  "name": "ikea-mcp",
  "version": "1.9.0",
  "description": "MCP server for IKEA product search and live in-store stock in the US, Canada and Norway: find the nearest store that has an item or a whole shopping list. Read-only, stdio and Streamable HTTP.",
  "license": "MIT",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "ikea-mcp": "dist/index.js"
  },
  "files": [
    "dist/",
    "Procfile",
    "CHANGELOG.md"
  ],
  "keywords": [
    "mcp",
    "ikea",
    "model-context-protocol",
    "stock",
    "inventory",
    "mcp-server",
    "claude",
    "store-locator",
    "availability"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/taejin5314/ikea-mcp.git"
  },
  "homepage": "https://github.com/taejin5314/ikea-mcp#readme",
  "bugs": {
    "url": "https://github.com/taejin5314/ikea-mcp/issues"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsx src/index.ts",
    "dev:http": "tsx src/http.ts",
    "start": "node dist/index.js",
    "start:http": "node dist/http.js",
    "smoke": "node smoke.mjs",
    "smoke:http": "node smoke-http.mjs",
    "test": "node --import tsx/esm --test test/unit.test.ts",
    "typecheck": "tsc -p tsconfig.test.json",
    "prepublishOnly": "npm run build && npm test"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0",
    "zod": "^3.22.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.0.0"
  }
}
